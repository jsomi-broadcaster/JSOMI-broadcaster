<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.pedro.rtplibrary.view.OpenGlView
        android:id="@+id/previewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvLiveStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:text="● LIVE"
        android:textColor="#FF0000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:background="#66000000"
        android:padding="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_gravity="bottom"
        android:background="#AA000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JSTV LIVE"
                android:textColor="#FFEB3B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvScrolling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to JSTV - Paybill 516600 - WhatsApp 0763052911"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvViewers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Viewers: 0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvRtmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgOverlayLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etStreamKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Paste Stream KEY ONLY"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <EditText
                android:id="@+id/etStreamTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Stream Title"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <EditText
                android:id="@+id/etScrollText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Scrolling Text"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <EditText
                android:id="@+id/etTimerMins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Timer Minutes e.g. 30"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <Spinner android:id="@+id/spPlatform" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/spResolution" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/spBitrate" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/spFps" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/spIntro" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/spOrientation" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <Button android:id="@+id/btnGoLive" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GO LIVE" />
            <Button android:id="@+id/btnSwitchCamera" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SWITCH CAMERA" />
            <Button android:id="@+id/btnFlash" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FLASH" />
            <Button android:id="@+id/btnMic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MIC ON" />
            <Button android:id="@+id/btnAudioOnly" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AUDIO ONLY" />
            <Button android:id="@+id/btnRecord" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RECORD" />
            <Button android:id="@+id/btnGallery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GALLERY / LOGO" />
            <Button android:id="@+id/btnTitleStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SET TITLE" />
            <Button android:id="@+id/btnScrollText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SET SCROLL TEXT" />
            <Button android:id="@+id/btnProgramTimer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="START TIMER" />
            <Button android:id="@+id/btnLoop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LOOP MODE" />
            <Button android:id="@+id/btnChurchScreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHURCH SCREEN" />
            <Button android:id="@+id/btnPayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="UPGRADE TO PREMIUM - PAYBILL 516600" />
            <Button android:id="@+id/btnWhatsApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WHATSAPP SUPPORT" />
            <Button android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BACK" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
