<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootStudio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CAMERA VIDEO - Full Screen -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 CAMERA"
            android:textColor="#555555"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- INTRO VIDEO LOOP - Hidden until you tap Intro -->
    <VideoView
        android:id="@+id/videoIntro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- LIVE INDICATOR - Top Left, Hidden until Go Live -->
    <LinearLayout
        android:id="@+id/liveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC0000"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_margin="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLiveTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- LOGO - Top Right, Draggable -->
    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JSTV"
        android:textColor="#FFC107"
        android:textStyle="bold"
        android:textSize="22sp"
        android:background="#80000000"
        android:padding="8dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp" />

    <!-- MOVABLE TITLE - Drag Anywhere -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to JSTV Live"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="#80000000"
        android:padding="8dp"
        android:layout_gravity="center"
        android:layout_marginTop="80dp" />

    <!-- SCROLLING TEXT - Single Line, Draggable, Bottom -->
    <TextView
        android:id="@+id/tvTicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome to JSTV - God Bless You - Subscribe - Share - Like  •  "
        android:textColor="#FFFF00"
        android:textSize="16sp"
        android:background="#AA000000"
        android:padding="8dp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_gravity="bottom"
        android:layout_marginBottom="180dp" />

    <!-- CONTROL PANEL - Hidden after Go Live -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="12dp"
        android:layout_gravity="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Type Title..."
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnSetTitle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="SET"
                android:backgroundTint="#FFC107"
                android:textColor="#000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etTicker"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Type Scrolling Text..."
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnSetTicker"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="SET"
                android:backgroundTint="#FFC107"
                android:textColor="#000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnIntro"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="▶ INTRO"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnLogo"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="🖼 LOGO"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="↻ ROTATE"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnMute"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="🎤"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnMultiStream"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="📡 MULTI-STREAM"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGoLive"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="🔴 GO LIVE"
                android:backgroundTint="#FF0000"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- END BUTTON - Only shows after Go Live, Fullscreen -->
    <Button
        android:id="@+id/btnEndLive"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="■ END"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

</FrameLayout>
