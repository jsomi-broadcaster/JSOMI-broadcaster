<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JSTV BROADCASTER"
            android:textColor="#FFFF00"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.pedro.rtplibrary.view.OpenGlView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvBible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="John 3:16 - For God so loved the world"
            android:textColor="#FFFF00"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvTicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to JSTV - Jesus Saves TV"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp" />

        <CheckBox
            android:id="@+id/cbYT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etYTKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="YouTube Stream Key"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <CheckBox
            android:id="@+id/cbFB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Facebook"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etFBKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Facebook Stream Key"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <CheckBox
            android:id="@+id/cbTikTok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TikTok"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etTikTokKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="TikTok Stream Key"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <CheckBox
            android:id="@+id/cbCustom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom RTMP"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etCustomUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom RTMP URL e.g. rtmp://..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <EditText
            android:id="@+id/etCustomKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom Stream Key"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888" />

        <EditText
            android:id="@+id/etBibleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type Bible verse"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnSetBible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SET BIBLE VERSE" />

        <Button
            android:id="@+id/btnGoLive"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="GO LIVE"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
