<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvStudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JSTV - PICK ROLE"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="10dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pick your role"
        android:textColor="#FFFFFF"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvMainInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#AAAAAA"
        android:gravity="center" />

    <!-- ROLE PICKER - always visible -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnStudio1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="I AM STUDIO 1" />
        <Button android:id="@+id/btnStudio2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="I AM STUDIO 2" />
        <Button android:id="@+id/btnMain" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="I AM MAIN" />
    </LinearLayout>

    <!-- STUDIO CAMERA -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111" />

    <!-- MAIN VIEWS - hidden until MAIN picked -->
    <LinearLayout
        android:id="@+id/layoutMainViews"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView android:id="@+id/tvMainOnAir" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ON AIR: STUDIO 1" android:textColor="#FF0000" android:textStyle="bold" android:gravity="center" />

        <ImageView android:id="@+id/imgMainBig" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:background="#222222" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="120dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STUDIO 1 - Tap to show" android:textColor="#FFFFFF" android:gravity="center" />
                <ImageView android:id="@+id/imgStudio1Main" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:background="#333333" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STUDIO 2 - Tap to show" android:textColor="#FFFFFF" android:gravity="center" />
                <ImageView android:id="@+id/imgStudio2Main" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:background="#333333" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- STUDIO CONTROLS -->
    <LinearLayout
        android:id="@+id/layoutStudioControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText android:id="@+id/etMainIp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Main IP - e.g. 192.168.43.1" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
        <Button android:id="@+id/btnSend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEND TO MAIN" />
        <Button android:id="@+id/btnStopSend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STOP SENDING" />
        <Button android:id="@+id/btnOpenCamera" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OPEN CAMERA" />
        <Button android:id="@+id/btnSwitchCamera" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SWITCH CAMERA" />
        <Button android:id="@+id/btnFlash" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FLASH" />
    </LinearLayout>

</LinearLayout>
