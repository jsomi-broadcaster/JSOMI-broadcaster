<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- TOP BAR -->
    <TextView
        android:id="@+id/tvPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MAIN STUDIO - Main Event Camera | Plan: FREE"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:padding="8dp"
        android:background="#222222" />

    <!-- AD BANNER - FREE PLAN ONLY -->
    <TextView
        android:id="@+id/adBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📢 AD - Upgrade to Premium to remove ads - Paybill 516600"
        android:textColor="#000000"
        android:background="#FFEB3B"
        android:gravity="center"
        android:padding="6dp"
        android:textSize="12sp" />

    <!-- LIVE STATUS -->
    <TextView
        android:id="@+id/tvLiveStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● OFFLINE"
        android:textColor="#FF5252"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="4dp" />

    <!-- CAMERA PREVIEW - REAL RTMP -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <com.pedro.library.view.OpenGlView
            android:id="@+id/previewMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- OVERLAY TITLE - DRAGGABLE -->
        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 JSTV LIVE"
            android:textColor="#FFFF00"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="top|center_horizontal"
            android:padding="8dp" />

        <!-- OVERLAY LOGO - DRAGGABLE -->
        <ImageView
            android:id="@+id/imgOverlayLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="top|end"
            android:contentDescription="Logo" />

        <!-- SCROLLING TEXT - DRAGGABLE - FIXED, NO android:selected -->
        <TextView
            android:id="@+id/tvScrolling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📢 Welcome to JSTV • Paybill 516600 • WhatsApp 0763052911 • "
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_gravity="bottom"
            android:background="#80000000"
            android:padding="6dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </FrameLayout>

    <!-- CONTROLS - SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#111111">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvViewers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👁 Viewers: 0 | ⏱ Program: Not Started"
                android:textColor="#FFFFFF"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tvRtmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RTMP: rtmps://live-api-s.facebook.com:443/rtmp/ + YOUR KEY"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Platform:"
                android:textColor="#FFFFFF" />

            <Spinner
                android:id="@+id/spPlatform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stream Title:"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etStreamTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Stream Title"
                android:text
