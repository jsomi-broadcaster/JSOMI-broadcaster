<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="JSTV BROADCASTER - MULTISTREAM"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:gravity="center" />

        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Offline - Ready" android:textColor="#FFEB3B" android:textSize="16sp" android:gravity="center"
            android:padding="8dp" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="260dp" android:background="#000000">
            <SurfaceView android:id="@+id/cameraView" android:layout_width="match_parent" android:layout_height="match_parent" />
            <TextView android:id="@+id/tvBible" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="top" android:text="John 3:16 - For God so loved the world..."
                android:textColor="#FFFFFF" android:textSize="14sp" android:background="#80000000" android:padding="6dp" />
            <TextView android:id="@+id/tvTicker" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:text="Welcome to JSTV"
                android:textColor="#FFFF00" android:textSize="14sp" android:background="#CCFF0000" android:padding="6dp" />
        </FrameLayout>

        <EditText android:id="@+id/etBibleInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Type Bible Verse Here" android:textColor="#FFFFFF" android:textColorHint="#888888" />
        <Button android:id="@+id/btnSetBible" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SET BIBLE VERSE" />

        <EditText android:id="@+id/etTicker" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Type Ticker / Announcement" android:textColor="#FFFFFF" android:textColorHint="#888888" />

        <CheckBox android:id="@+id/cbYT" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="YouTube" android:textColor="#FFFFFF" android:checked="true" />
        <EditText android:id="@+id/etYTKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="YouTube Stream Key" android:textColor="#FFFFFF" android:textColorHint="#888888" />

        <CheckBox android:id="@+id/cbFB" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Facebook" android:textColor="#FFFFFF" />
        <EditText android:id="@+id/etFBKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Facebook Stream Key" android:textColor="#FFFFFF" android:textColorHint="#888888" />

        <CheckBox android:id="@+id/cbTikTok" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="TikTok" android:textColor="#FFFFFF" />
        <EditText android:id="@+id/etTikTokKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="TikTok RTMP URL + Key / Full URL" android:textColor="#FFFFFF" android:textColorHint="#888888" />

        <CheckBox android:id="@+id/cbCustom" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Custom RTMP" android:textColor="#FFFFFF" />
        <EditText android:id="@+id/etCustomUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Custom RTMP URL - rtmp://..." android:textColor="#FFFFFF" android:textColorHint="#888888" />
        <EditText android:id="@+id/etCustomKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Custom RTMP Key" android:textColor="#FFFFFF" android:textColorHint="#888888" />

        <Button android:id="@+id/btnGoLive" android:layout_width="match_parent" android:layout_height="60dp"
            android:text="GO LIVE - MULTISTREAM" android:textSize="18sp" android:backgroundTint="#FF0000" android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
