<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121212" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
<ImageView android:layout_width="170dp" android:layout_height="170dp" android:src="@mipmap/jstv_logo" android:layout_marginTop="10dp" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JSTV" android:textColor="#FFFFFF" android:textSize="72sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JSOMI BROADCASTER" android:textColor="#FFC107" android:textSize="18sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="For Streamers Only - Sign In To Stream" android:textColor="#AAAAAA" android:textSize="14sp" android:layout_marginBottom="28dp" />
<EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="56dp" android:hint="👤 Full Name" android:textColorHint="#888888" android:textColor="#000000" android:background="#FFFFFF" android:padding="12dp" android:drawableStart="@android:drawable/ic_menu_myplaces" android:drawablePadding="10dp" android:layout_marginBottom="14dp" />
<EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp" android:hint="📧 Email" android:textColorHint="#888888" android:textColor="#000000" android:background="#FFFFFF" android:padding="12dp" android:drawableStart="@android:drawable/ic_dialog_email" android:drawablePadding="10dp" android:inputType="textEmailAddress" android:layout_marginBottom="14dp" />
<EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="56dp" android:hint="🔒 Password" android:textColorHint="#888888" android:textColor="#000000" android:background="#FFFFFF" android:padding="12dp" android:drawableStart="@android:drawable/ic_lock_lock" android:drawablePadding="10dp" android:inputType="textPassword" android:layout_marginBottom="20dp" />
<Button android:id="@+id/btnSignUp" android:layout_width="match_parent" android:layout_height="56dp" android:text="SIGN UP - NEW STREAMER" android:backgroundTint="#FFC107" android:textColor="#000000" android:textStyle="bold" />
<Button android:id="@+id/btnSignIn" android:layout_width="match_parent" android:layout_height="56dp" android:text="SIGN IN" android:backgroundTint="#333333" android:textColor="#FFFFFF" android:layout_marginTop="12dp" />
<TextView android:id="@+id/tvGoToSignIn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Already have account? Tap SIGN IN" android:textColor="#AAAAAA" android:layout_marginTop="16dp" />
</LinearLayout>
</ScrollView>
