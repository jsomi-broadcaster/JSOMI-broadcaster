<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#111111">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🛠 5. DEVELOPER ADMIN" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage JSTV App - Only For Developer" android:textColor="#FF9800" android:gravity="center" android:layout_marginBottom="16dp" />

    <TextView android:id="@+id/tvDevStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stats loading..." android:textColor="#FFFFFF" android:background="#333333" android:padding="12dp" />
    <TextView android:id="@+id/tvDevUsers" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Users loading..." android:textColor="#FFFFFF" android:background="#222222" android:padding="12dp" android:layout_marginTop="8dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📢 ANNOUNCEMENT TO ALL USERS" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="16dp" />
    <EditText android:id="@+id/etAnnouncement" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Type announcement..." android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#333333" android:padding="10dp" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnSendAnnouncement" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEND ANNOUNCEMENT" android:backgroundTint="#7B1FA2" android:layout_marginTop="8dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌐 GLOBAL RTMP FOR ALL STREAMERS" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="16dp" />
    <EditText android:id="@+id/etGlobalRtmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="rtmp://..." android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#333333" android:padding="10dp" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnSaveRtmp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE GLOBAL RTMP" android:layout_marginTop="8dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚫 BAN / UNBAN USER" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="16dp" />
    <EditText android:id="@+id/etBanUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="User Email to Ban" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#333333" android:padding="10dp" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnBanUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🚫 BAN USER" android:backgroundTint="#FF0000" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnUnban" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✅ UNBAN ALL" android:backgroundTint="#43A047" android:layout_marginTop="8dp" />

    <Button android:id="@+id/btnViewLives" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔴 VIEW LIVE STREAMS" android:layout_marginTop="16dp" />
    <Button android:id="@+id/btnViewPayments" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="💰 VIEW PAYMENTS" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnViewChurch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⛪ VIEW CHURCH SCREENS" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnResetApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🗑 RESET APP - CLEAR ALL DATA" android:backgroundTint="#FF0000" android:layout_marginTop="16dp" />
    <Button android:id="@+id/btnBackDev" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⬅ BACK TO MENU" android:layout_marginTop="8dp" />

</LinearLayout>
</ScrollView>
