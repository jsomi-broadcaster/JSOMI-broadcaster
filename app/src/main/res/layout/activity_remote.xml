<Button android:id="@+id/btnRemoteGoLive" android:layout_width="match_parent" android:layout_height="70dp" android:text="🔴 REMOTE GO LIVE" android:backgroundTint="#FF0000" android:layout_marginBottom="10dp"/>
<Button android:id="@+id/btnRemoteEnd" android:layout_width="match_parent" android:layout_height="70dp" android:text="⏹ REMOTE END LIVE" android:layout_marginBottom="10dp"/>
