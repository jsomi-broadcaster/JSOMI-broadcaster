<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0A0A0A" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JSTV - BROADCASTER" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:gravity="center" android:padding="16dp" />
    <TextView android:id="@+id/tvWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Welcome" android:textColor="#AAAAAA" android:gravity="center" android:paddingBottom="16dp" />
    <Button android:id="@+id/btnMainStudio" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginBottom="8dp" android:text="🎬  1. MAIN STUDIO" android:textSize="16sp" android:backgroundTint="#FF0000" android:textColor="#FFFFFF" />
    <Button android:id="@+id/btnRemote" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginBottom="8dp" android:text="📱  2. REMOTE CONTROL" android:textSize="16sp" android:backgroundTint="#1E88E5" android:textColor="#FFFFFF" />
    <Button android:id="@+id/btnCamera" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginBottom="8dp" android:text="📷  3. CAMERA" android:textSize="16sp" android:backgroundTint="#43A047" android:textColor="#FFFFFF" />
    <Button android:id="@+id/btnChurch" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginBottom="8dp" android:text="⛪  4. CHURCH SCREEN" android:textSize="16sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF" />
    <Button android:id="@+id/btnDeveloper" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginBottom="8dp" android:text="🛠  5. DEVELOPER ADMIN - MANAGE APP" android:textSize="16sp" android:backgroundTint="#7B1FA2" android:textColor="#FFFFFF" />
    <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LOGOUT" />
</LinearLayout>
