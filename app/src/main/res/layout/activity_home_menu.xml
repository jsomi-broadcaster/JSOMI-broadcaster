<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JSTV - BROADCASTER" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" />
    <TextView android:id="@+id/tvWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Welcome, kevin" android:textSize="16sp" android:textColor="#AAAAAA" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" />

    <!-- 1. CHURCH SCREEN -->
    <Button android:id="@+id/btnChurchScreen" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="12dp" android:text="⛪ 1. CHURCH SCREEN" android:textSize="18sp" android:textColor="#FFFFFF" android:backgroundTint="#FF9800" />

    <!-- 2. STUDIO1 -->
    <Button android:id="@+id/btnStudio1" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="12dp" android:text="📷 2. STUDIO1" android:textSize="18sp" android:textColor="#FFFFFF" android:backgroundTint="#F44336" />

    <!-- 3. STUDIO2 -->
    <Button android:id="@+id/btnStudio2" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="12dp" android:text="📷 3. STUDIO2" android:textSize="18sp" android:textColor="#FFFFFF" android:backgroundTint="#2196F3" />

    <!-- 4. REMOTE CONTROL -->
    <Button android:id="@+id/btnRemote" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="12dp" android:text="📱 4. REMOTE CONTROL" android:textSize="18sp" android:textColor="#FFFFFF" android:backgroundTint="#4CAF50" />

    <!-- 5. ADMIN PORTAL -->
    <Button android:id="@+id/btnAdmin" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="12dp" android:text="🔐 5. ADMIN PORTAL" android:textSize="18sp" android:textColor="#FFFFFF" android:backgroundTint="#9C27B0" />

    <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="55dp" android:text="LOGOUT" android:textSize="16sp" android:textColor="#000000" android:backgroundTint="#CCCCCC" />

    <Button android:id="@+id/btnMainScreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GO TO MAIN SCREEN - LIVESTREAM" android:layout_marginTop="16dp" android:visibility="gone" />
</LinearLayout>
